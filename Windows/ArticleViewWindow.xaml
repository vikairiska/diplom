<Window x:Class="VerhozinaIvanovDiplom.Windows.ArticleViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerhozinaIvanovDiplom.Windows"
        mc:Ignorable="d"
        Title="Просмотр статьи" Height="800" Width="1040"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="20" Padding="26,24,26,26" BorderThickness="1" BorderBrush="#2A3948">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#161E2A" Offset="0"/>
                    <GradientStop Color="#112720" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="TitleTextBlock"
                       Text="Заголовок статьи"
                       FontSize="52"
                       FontWeight="SemiBold"
                       Foreground="#F5F8FD"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="270"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#141B26" Margin="0,0,0,12" CornerRadius="16" BorderBrush="#2A3948" BorderThickness="1">
                <Image x:Name="ArticleImage" Stretch="Uniform"/>
            </Border>

            <Border Grid.Row="1" CornerRadius="16" Background="#141B26" BorderBrush="#2A3948" BorderThickness="1" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <GroupBox Grid.Row="2" Header="Комментарии" Margin="0,12,0,8">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="CommentsListBox" Grid.Row="0" BorderThickness="0" Padding="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1A2332" BorderBrush="#2A3948" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Foreground="#F0F5FC" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource DangerIconButtonStyle}"
                                                ToolTip="Удалить комментарий"
                                                Margin="10,0,0,0"
                                                Visibility="{Binding DeleteVisibility}"
                                                Tag="{Binding CommentId}"
                                                Click="DeleteCommentButton_Click">
                                            <Viewbox Width="16" Height="16">
                                                <Path Fill="#FFFFFF" Data="{StaticResource DeleteIconGeometry}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding Text}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#BFCCDC"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewCommentTextBox" Height="38" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Отправить" Width="138" Height="38"
                            Style="{StaticResource ButtonStyleGreen}"
                            IsDefault="True"
                            Click="SendCommentButton_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="AddTestButton" Content="Добавить тест" Style="{StaticResource ButtonStyleGreen}"
                    Width="150" Height="38" Margin="0,0,10,0"
                    Click="AddTestButton_Click"/>
            <Button x:Name="PassTestButton" Content="Пройти тест" Style="{StaticResource ButtonStyleGreen}"
                    Width="140" Height="38" Margin="0,0,10,0"
                    Click="PassTestButton_Click"/>
            <Button x:Name="EditButton" Style="{StaticResource IconButtonStyle}"
                    ToolTip="Редактировать"
                    Margin="0,0,10,0"
                    Click="EditButton_Click">
                <Viewbox Width="18" Height="18">
                    <Path Fill="#F4F7FB" Data="{StaticResource EditIconGeometry}"/>
                </Viewbox>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource DangerIconButtonStyle}"
                    ToolTip="Удалить"
                    Margin="0,0,10,0"
                    Click="DeleteButton_Click">
                <Viewbox Width="18" Height="18">
                    <Path Fill="#FFFFFF" Data="{StaticResource DeleteIconGeometry}"/>
                </Viewbox>
            </Button>
            <Button Content="Закрыть" Style="{StaticResource ButtonStyleGreen}"
                    Width="120" Height="38"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
