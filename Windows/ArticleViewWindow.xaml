<Window x:Class="VerhozinaIvanovDiplom.Windows.ArticleViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerhozinaIvanovDiplom.Windows"
        mc:Ignorable="d"
        Title="Просмотр статьи" Height="760" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <TextBlock x:Name="TitleTextBlock" 
                       Text="Заголовок статьи" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Изображение -->
            <Border Grid.Row="0" Background="#F5F5F5" Margin="0,0,0,12" CornerRadius="8">
                <Image x:Name="ArticleImage" Stretch="Uniform"/>
            </Border>

            <!-- Основной текст -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ContentTextBlock" 
                           Text="Текст статьи" 
                           FontSize="14" 
                           TextWrapping="Wrap"
                           LineHeight="22"/>
            </ScrollViewer>
        </Grid>

        <GroupBox Grid.Row="2" Header="Комментарии" Margin="16,0,16,8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="CommentsListBox" Grid.Row="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Text}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewCommentTextBox" Height="32" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Отправить" Width="120" Height="32"
                            Style="{StaticResource ButtonStyleGreen}"
                            Click="SendCommentButton_Click"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <Button x:Name="AddTestButton" Content="Добавить тест" Style="{StaticResource ButtonStyleGreen}"
                    Width="150" Height="35" Margin="0,0,10,0"
                    Click="AddTestButton_Click"/>
            <Button x:Name="PassTestButton" Content="Пройти тест" Style="{StaticResource ButtonStyleGreen}"
                    Width="140" Height="35" Margin="0,0,10,0"
                    Click="PassTestButton_Click"/>
            <Button x:Name="EditButton" Content="Редактировать" Style="{StaticResource ButtonStyleGreen}"
                    Width="140" Height="35" Margin="0,0,10,0"
                    Click="EditButton_Click"/>
            <Button x:Name="DeleteButton" Content="Удалить" Style="{StaticResource ButtonStyleGreen}"
                    Width="120" Height="35" Margin="0,0,10,0"
                    Click="DeleteButton_Click"/>
            <Button Content="Закрыть" Style="{StaticResource ButtonStyleGreen}"
                    Width="120" Height="35"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
