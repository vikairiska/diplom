<Window x:Class="VerhozinaIvanovDiplom.Windows.ArticlePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр статьи"
        Height="780"
        Width="1000"
        MinHeight="520"
        MinWidth="720"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="20" Padding="26,24,26,26" BorderThickness="1" BorderBrush="#2A3948">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#161E2A" Offset="0"/>
                    <GradientStop Color="#112720" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock x:Name="TitleTextBlock"
                       FontSize="48"
                       FontWeight="SemiBold"
                       Foreground="#F5F8FD"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid x:Name="ArticleBodyGrid" Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="270"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="CoverBorder" Grid.Row="0" Background="#141B26" Margin="0,0,0,12" CornerRadius="16" BorderBrush="#2A3948" BorderThickness="1">
                <Image x:Name="ArticleImage" Stretch="Uniform"/>
            </Border>

            <Border Grid.Row="1" CornerRadius="16" Background="#141B26" BorderBrush="#2A3948" BorderThickness="1" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Style="{StaticResource ButtonStyleGreen}"
                    Width="120" Height="38"
                    IsCancel="True"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
