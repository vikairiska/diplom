<Window x:Class="VerhozinaIvanovDiplom.Windows.AssignTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначение тестов"
        Height="420"
        Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Назначить тест пользователю" FontSize="22" FontWeight="Bold"/>

        <TextBlock Grid.Row="1" Margin="0,12,0,4" Text="Пользователь"/>
        <ComboBox x:Name="UsersComboBox" Grid.Row="2" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="3" Margin="0,12,0,4" Text="Тест"/>
        <ComboBox x:Name="TestsComboBox" Grid.Row="4" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="Id" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Назначить"
                    Width="130"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="AssignButton_Click"/>
            <Button Content="Закрыть"
                    Width="120"
                    Height="35"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
