<Window x:Class="VerhozinaIvanovDiplom.Windows.UserProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогресс пользователя"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTextBlock" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" Margin="0,8,0,12" FontSize="14"/>

        <DataGrid x:Name="ProgressDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тест" Binding="{Binding TestTitle}" Width="*"/>
                <DataGridTextColumn Header="Баллы" Binding="{Binding ScoreText}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding EndDateText}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3"
                Content="Закрыть"
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Style="{StaticResource ButtonStyleGreen}"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
