<Window x:Class="VerhozinaIvanovDiplom.Windows.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль пользователя"
        Height="760"
        Width="900"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Профиль" FontSize="24" FontWeight="Bold"/>

        <Grid Grid.Row="1" Margin="0,12,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border BorderThickness="1" BorderBrush="#2A3948" Background="#141B26" CornerRadius="12" Padding="8">
                    <Image x:Name="PhotoImage" Height="180" Stretch="UniformToFill"/>
                </Border>
                <Button Content="Выбрать фото"
                        Height="32"
                        Margin="0,10,0,0"
                        Style="{StaticResource ButtonStyleGreen}"
                        Click="ChoosePhotoButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Имя" Margin="0,0,0,4"/>
                <TextBox x:Name="FullNameTextBox" Height="32"/>

                <TextBlock Text="Возраст" Margin="0,12,0,4"/>
                <TextBox x:Name="AgeTextBox" Height="32"/>

                <TextBlock Text="Специализация" Margin="0,12,0,4"/>
                <ComboBox x:Name="SpecialtyComboBox" Height="32" IsEditable="False"/>

                <TextBlock Text="Город" Margin="0,12,0,4"/>
                <ComboBox x:Name="CityComboBox" Height="32" IsEditable="False"/>

                <TextBlock Text="Логин" Margin="0,12,0,4"/>
                <TextBox x:Name="LoginTextBox" Height="32" IsReadOnly="True"/>

                <Separator Margin="0,14,0,10"/>
                <TextBlock Text="Смена пароля" FontWeight="SemiBold"/>

                <TextBlock Text="Текущий пароль" Margin="0,10,0,4"/>
                <PasswordBox x:Name="CurrentPasswordBox" Height="32"/>

                <TextBlock Text="Новый пароль" Margin="0,10,0,4"/>
                <PasswordBox x:Name="NewPasswordBox" Height="32"/>

                <TextBlock Text="Подтверждение пароля" Margin="0,10,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="32"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="2" Header="Мой прогресс по тестам" Padding="8">
            <DataGrid x:Name="ProgressDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Тест" Binding="{Binding TestTitle}" Width="*"/>
                    <DataGridTextColumn Header="Баллы" Binding="{Binding ScoreText}" Width="120"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding EndDateText}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Открыть детально"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="OpenDetailedProgressButton_Click"/>
            <Button Content="Сменить пароль"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="ChangePasswordButton_Click"/>
            <Button Content="Сохранить"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="SaveButton_Click"/>
            <Button Content="Закрыть"
                    Width="120"
                    Height="35"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
