<Window x:Class="VerhozinaIvanovDiplom.Windows.UsersProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогресс пользователей"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Прогресс пользователей" FontSize="24" FontWeight="Bold"/>

        <ListView x:Name="UsersListView" Grid.Row="1" Margin="0,12,0,12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фото" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="48" Height="48" CornerRadius="24" BorderBrush="#CCCCCC" BorderThickness="1">
                                    <Image Source="{Binding Photo}" Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="260"/>
                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="180"/>
                    <GridViewColumn Header="Попыток" DisplayMemberBinding="{Binding Attempts}" Width="120"/>
                    <GridViewColumn Header="Успешных" DisplayMemberBinding="{Binding Passed}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Открыть прогресс"
                    Width="170"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="OpenProgressButton_Click"/>
            <Button Content="Закрыть"
                    Width="120"
                    Height="35"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
