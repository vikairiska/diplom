<Window x:Class="VerhozinaIvanovDiplom.Windows.AddArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerhozinaIvanovDiplom.Windows"
        mc:Ignorable="d"
        Title="Добавление статьи" Height="680" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        MinHeight="500" MinWidth="600">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название статьи -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Название статьи:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TitleTextBox" FontSize="14" Padding="8" Height="35" 
                     TextWrapping="Wrap" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Изображение -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Изображение статьи:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SelectImageButton" Content="Выбрать изображение" 
                        Style="{StaticResource ButtonStyleGreen}" 
                        Width="200" Height="38"
                        Click="SelectImageButton_Click"/>
                <TextBlock x:Name="ImagePathTextBlock" Text="Изображение не выбрано" 
                           VerticalAlignment="Center" Margin="15,0,0,0" 
                           Foreground="#8EA2B8" MaxWidth="400" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border x:Name="ImagePreviewBorder" Margin="0,10,0,0" MaxHeight="210" 
                    Background="#141B26" BorderBrush="#2A3948" BorderThickness="1" CornerRadius="12"
                    Visibility="Collapsed">
                <Image x:Name="ImagePreview" Stretch="Uniform" MaxHeight="210"/>
            </Border>
        </StackPanel>

        <!-- Основной текст -->
        <StackPanel Grid.Row="2" Margin="0,0,0,5">
            <TextBlock Text="Основной текст:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
        </StackPanel>
        
        <TextBox x:Name="ContentTextBox" Grid.Row="3" FontSize="13" Padding="10" 
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" FontFamily="Segoe UI"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="EditButton" Style="{StaticResource IconButtonStyle}"
                    ToolTip="Редактировать" Margin="0,0,10,0" Visibility="Collapsed"
                    Click="EditButton_Click">
                <Viewbox Width="18" Height="18">
                    <Path Fill="#F4F7FB" Data="{StaticResource EditIconGeometry}"/>
                </Viewbox>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource DangerIconButtonStyle}"
                    ToolTip="Удалить" Margin="0,0,10,0" Visibility="Collapsed"
                    Click="DeleteButton_Click">
                <Viewbox Width="18" Height="18">
                    <Path Fill="#FFFFFF" Data="{StaticResource DeleteIconGeometry}"/>
                </Viewbox>
            </Button>
            <Button Content="Отмена" Style="{StaticResource ButtonStyleGreen}"
                    Width="120" Height="38" Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource ButtonStyleGreen}"
                    Width="130" Height="38"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
