<Window x:Class="VerhozinaIvanovDiplom.Windows.AssignedTestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначенные тесты"
        Height="520"
        Width="820"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Назначенные мне тесты" FontSize="22" FontWeight="Bold"/>

        <DataGrid x:Name="AssignedTestsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,12,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тест" Binding="{Binding TestTitle}" Width="*"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="Назначен" Binding="{Binding AssignedDateText}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Пройти выбранный тест"
                    Width="200"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="TakeSelectedButton_Click"/>
            <Button Content="Обновить"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="RefreshButton_Click"/>
            <Button Content="Закрыть"
                    Width="120"
                    Height="35"
                    Style="{StaticResource ButtonStyleGreen}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
