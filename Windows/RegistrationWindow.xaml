<Window x:Class="VerhozinaIvanovDiplom.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Регистрация"
        Height="640"
        Width="430"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Регистрация"
                   FontSize="34"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

        <TextBlock Grid.Row="1" Text="Логин:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="LoginTextBox" Height="36" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Имя (необязательно):" Margin="0,0,0,5"/>
        <TextBox Grid.Row="4" x:Name="FullNameTextBox" Height="36" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="5" Text="Специализация:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="6" x:Name="SpecialtyComboBox" Height="36" Margin="0,0,0,12"
                  IsEditable="False"/>

        <TextBlock Grid.Row="7" Text="Город:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="8" x:Name="CityComboBox" Height="36" Margin="0,0,0,12"
                  IsEditable="False"/>

        <TextBlock Grid.Row="9" Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="10" x:Name="PasswordBox" Height="36" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="11" Text="Подтверждение пароля:" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="12" x:Name="ConfirmPasswordBox" Height="36" Margin="0,0,0,15" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0">
            <Button Content="Зарегистрироваться"
                    Width="180"
                    Height="40"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="RegisterButton_Click"/>
            <Button Content="Отмена"
                    Width="120"
                    Height="40"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
