<Window x:Class="VerhozinaIvanovDiplom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerhozinaIvanovDiplom"
        xmlns:pages="clr-namespace:VerhozinaIvanovDiplom.Pages"
        mc:Ignorable="d"
        Title="Обучение устройству автомобиля" Height="680" Width="1180"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="Resources/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource MenuContainerStyle}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AddMenuButton" Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Добавить" Margin="0,0,8,0"/>
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="#DCE8F6" Data="M10,4V10H16V12H10V18H8V12H2V10H8V4H10Z"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AssignMenuButton" Content="Назначить" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="UsersMenuButton" Content="Пользователи" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="SearchMenuButton" Style="{StaticResource MenuButtonStyle}" ToolTip="Найти">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="#DCE8F6"
                                          Data="M9.5,2A7.5,7.5 0 0,1 17,9.5C17,11.29 16.37,12.93 15.31,14.21L19.3,18.2L18.2,19.3L14.21,15.31C12.93,16.37 11.29,17 9.5,17A7.5,7.5 0 0,1 2,9.5A7.5,7.5 0 0,1 9.5,2M9.5,3.6A5.9,5.9 0 0,0 3.6,9.5A5.9,5.9 0 0,0 9.5,15.4A5.9,5.9 0 0,0 15.4,9.5A5.9,5.9 0 0,0 9.5,3.6Z"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MyProfileMenuButton" Content="Мой профиль" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="AssignedTestsMenuButton" Content="Назначенные тесты" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="UsersProgressMenuButton" Content="Прогресс пользователей" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="LogoutMenuButton" Style="{StaticResource MenuButtonStyle}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Выйти" Margin="0,0,8,0"/>
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="#DCE8F6" Data="M14.08,15.59L16.67,13H7V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M4,5H11V3H4C2.89,3 2,3.89 2,5V19C2,20.1 2.89,21 4,21H11V19H4V5Z"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Frame Grid.Row="1" NavigationUIVisibility="Hidden" Source="Pages/HomePage.xaml" Margin="16,4,16,16"/>
    </Grid>
</Window>
