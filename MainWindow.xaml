<Window x:Class="VerhozinaIvanovDiplom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VerhozinaIvanovDiplom"
        xmlns:pages="clr-namespace:VerhozinaIvanovDiplom.Pages"
        mc:Ignorable="d"
        Title="Обучение устройству автомобиля" Height="680" Width="1180"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        Icon="Resources/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource MenuContainerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="24" Background="#1A2434" VerticalAlignment="Center" Margin="4,0,14,0">
                    <Viewbox Width="20" Height="20">
                        <Path Fill="#E6EEF8" Data="M11,4A7,7 0 0,0 4,11C4,14.87 7.13,18 11,18C14.87,18 18,14.87 18,11C18,7.13 14.87,4 11,4M11,2C15.97,2 20,6.03 20,11C20,15.97 15.97,20 11,20C6.03,20 2,15.97 2,11C2,6.03 6.03,2 11,2M13.2,7.2L9,11.4L7.3,9.7L6,11L9,14L14.5,8.5L13.2,7.2Z"/>
                    </Viewbox>
                </Border>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="AddMenuButton" Content="Добавить" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="AssignMenuButton" Content="Назначить" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="UsersMenuButton" Content="Пользователи" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="SearchMenuButton" Style="{StaticResource MenuButtonStyle}" ToolTip="Найти">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="16" Height="16">
                                    <Path Fill="#DCE8F6"
                                          Data="M9.5,2A7.5,7.5 0 0,1 17,9.5C17,11.29 16.37,12.93 15.31,14.21L19.3,18.2L18.2,19.3L14.21,15.31C12.93,16.37 11.29,17 9.5,17A7.5,7.5 0 0,1 2,9.5A7.5,7.5 0 0,1 9.5,2M9.5,3.6A5.9,5.9 0 0,0 3.6,9.5A5.9,5.9 0 0,0 9.5,15.4A5.9,5.9 0 0,0 15.4,9.5A5.9,5.9 0 0,0 9.5,3.6Z"/>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                        <Button x:Name="MyProfileMenuButton" Content="Мой профиль" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="AssignedTestsMenuButton" Content="Назначенные тесты" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="UsersProgressMenuButton" Content="Прогресс пользователей" Style="{StaticResource MenuButtonStyle}"/>
                        <Button x:Name="LogoutMenuButton" Content="Выйти" Style="{StaticResource MenuButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Frame Grid.Row="1" NavigationUIVisibility="Hidden" Source="Pages/HomePage.xaml" Margin="16,4,16,16"/>
    </Grid>
</Window>
